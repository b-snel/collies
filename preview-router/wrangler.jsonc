// Branch previews at <branch>.collies.app: forwards to the `collies` Worker's
// preview URL, <branch>-collies.thebrypod.workers.dev. Deploy: import this repo
// as a Worker named collies-previews, root directory preview-router.
// Needs a proxied wildcard DNS record: * AAAA 100::
{
  "name": "collies-previews",
  "main": "index.js",
  "compatibility_date": "2025-06-01",
  "routes": [{ "pattern": "*.collies.app/*", "zone_name": "collies.app" }],
  "workers_dev": false,
  "vars": { "TARGET": "collies.thebrypod.workers.dev" }
}
