// Cloudflare Workers: static site from dist/ (built by build.js), and worker.js for /turn (online co-op's relay;
// TURN_KEY_ID below, secret TURN_KEY_TOKEN). Production at collies.app, plus branch previews.
{
  "name": "collies",
  "compatibility_date": "2025-06-01",
  "main": "worker.js",
  "keep_vars": true,   // (variables set in the dashboard survive a deploy)
  // the relay's key (Realtime → TURN Server, not the Serverless SFU): its Turn Token ID here, its API token a secret in the dashboard (TURN_KEY_TOKEN)
  "vars": { "TURN_KEY_ID": "b632ee074b29866d875bce428c654d15" },
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "routes": [{ "pattern": "collies.app", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true
}
