// Cloudflare Workers: this branch's own Worker, served at original-fever-dream.collies.app.
// The Worker in the dashboard must have this exact name, with production branch original-fever-dream.
{
  "name": "collies-original-fever-dream",
  "compatibility_date": "2025-06-01",
  "assets": { "directory": "./dist" },
  "routes": [{ "pattern": "original-fever-dream.collies.app", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true
}
