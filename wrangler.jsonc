// Cloudflare Workers: static site from dist/ (built by build.js). Production at
// collies.app, plus branch previews.
{
  "name": "collies",
  "compatibility_date": "2025-06-01",
  "assets": { "directory": "./dist" },
  "routes": [{ "pattern": "collies.app", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true
}
